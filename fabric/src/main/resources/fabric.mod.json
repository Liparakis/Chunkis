{
    "schemaVersion": 1,
    "id": "chunkis",
    "version": "${version}",
    "name": "Chunkis",
    "description": "Chunkis is a mod that adds chunk saving and loading to Minecraft.",
    "authors": [
        "Liparakis"
    ],
    "license": "MIT",
    "icon": "assets/logo.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "io.liparakis.chunkis.ChunkisMod"
        ]
    },
    "mixins": [
        "chunkis.mixins.json",
        "chunkis.compat.mixins.json"
    ],
    "accessWidener": "chunkis.accesswidener",
    "depends": {
        "fabricloader": ">=0.16.5",
        "minecraft": "~1.21.11",
        "java": ">=21",
        "fabric-api": "*"
    }
}
